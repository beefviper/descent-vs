root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# The original sources are indented with tabs, three columns wide.
[*.{c,h,asm,inc}]
indent_style = tab
tab_width = 3
indent_size = 3

[{CMakeLists.txt,*.cmake,*.md}]
indent_style = space
indent_size = 4
